# Public access: no accounts or passwords. Production requires HTTPS for Secure cookies.
APP_ENV=development
DATA_DIR=data
# True for Render Free: files and workspace sessions may disappear with instance storage.
EPHEMERAL_STORAGE=false
# Sliding anonymous cookie lifetime; losing the cookie means losing workspace access.
SESSION_TTL_DAYS=30
MAX_UPLOAD_BYTES=5242880
# Per-workspace limit and service-wide storage guard (includes retained legacy documents).
MAX_DOCUMENTS=50
MAX_TOTAL_DOCUMENTS=500
MAX_QUERY_CHARS=2000
# Generation per IP AND workspace; separate service-wide cap. Single worker only.
REQUESTS_PER_MINUTE=30
GLOBAL_REQUESTS_PER_MINUTE=30
UPLOAD_REQUESTS_PER_MINUTE=5
IP_UPLOAD_REQUESTS_PER_MINUTE=10
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Questions and selected retrieved passages go to OpenRouter; entire PDFs are not sent.
# The only required secret for AI answers. Keep it in private .env/hosting settings.
GENERATION_PROVIDER=openai
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=baidu/ernie-5.5-flash-preview:free
OPENAI_API_KEY=
GENERATION_TIMEOUT_SECONDS=30
GENERATION_MAX_TOKENS=3072
# GENERATION_PROVIDER=local disables remote generation; it does not fabricate answers.
