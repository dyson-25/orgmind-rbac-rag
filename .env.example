# Synthetic demonstration only. No real credentials belong in this file.
APP_ENV=development
# Legacy passwordless diagnostics only; keep false for the product experience.
ALLOW_DEMO_PERSONA=false
# Optional explicitly provisioned synthetic credential accounts (paired values).
# Set secrets privately. Existing accounts are not reset on every startup.
DEMO_ADMIN_USERNAME=
DEMO_ADMIN_PASSWORD=
DEMO_EMPLOYEE_USERNAME=
DEMO_EMPLOYEE_PASSWORD=
# Required in production: at least 32 random characters; leave blank for ephemeral dev key.
JWT_SECRET=
DATA_DIR=data
MAX_UPLOAD_BYTES=5242880
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Optional generation: local (default), azure, groq, or openai.
# External generation sends the question and authorized, non-quarantined context
# to the selected provider. Local extractive generation requires no API keys.
GENERATION_PROVIDER=local
# Positive, finite HTTP timeout in seconds.
GENERATION_TIMEOUT_SECONDS=15

# Azure OpenAI: endpoint, API key, and chat deployment required for azure generation.
# Endpoint example: https://your-resource.openai.azure.com (no deployment path).
# Endpoint, key, and API version are shared with optional Azure embeddings.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=

# Groq: API key required for groq generation. Embeddings are not supported here.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI-compatible generation: API key required for openai generation.
# Base URL includes /v1, not /chat/completions; key and URL are shared with embeddings.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional embedding adapter: local (default), azure, or openai; independent of generation.
# Exposed for future integration only: NOT wired into retrieval. Retrieval retains
# local LSA regardless of these settings. Local embed() returns None without HTTP.
# Direct external adapter use sends supplied text to the configured provider.
EMBEDDING_PROVIDER=local
EMBEDDING_TIMEOUT_SECONDS=15
# Required only for the azure embedding adapter; separate from the chat deployment.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
# Model used only by the openai embedding adapter.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
